# Local-development settings. Copy to .env (git-ignored).
# TSAGENT_* values are read from .env automatically. Credentials and ${VAR} placeholders in the
# YAML files are read from the real process environment, so export the whole file:
#   set -a; . ./.env; set +a; python -m tsagent
# On OpenShift the same variables come from the tsagent-env ConfigMap and the Secret instead.
# Full reference: deploy/README.md

# -- paths --
TSAGENT_CONFIG_DIR=config
TSAGENT_DB_PATH=data/cases.db
TSAGENT_CHECKPOINT_PATH=data/checkpoints.db
# TSAGENT_UI_DIR=web/dist          # after `cd web && npm run build`

# -- server --
TSAGENT_HOST=0.0.0.0
TSAGENT_PORT=8080
TSAGENT_LOG_LEVEL=INFO
TSAGENT_LOG_FORMAT=text
# TSAGENT_CORS_ORIGINS=http://localhost:5173

# -- settings.yaml overrides (TSAGENT_<SECTION>__<KEY>) --
# TSAGENT_CORRELATION__WINDOW_SECONDS=60
# TSAGENT_REFLECTION__ENABLED=false
# TSAGENT_DEMO__ENABLED=true
# TSAGENT_LLM_PROFILE=ollama

# -- credentials referenced from clusters.yaml / llm.yaml --
# TSAGENT_DIRECTOR_PASSWORD=
# TSAGENT_PROM_TOKEN=
# ANTHROPIC_API_KEY=
